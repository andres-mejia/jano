    {
      "Sid": "NoTocarRecursosEtiquetadosDeFenoraNiCardea",
      "Effect": "Deny",
      "Action": [
        "ec2:*",
        "elasticloadbalancing:*",
        "rds:*",
        "autoscaling:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": [
            "fenora",
            "cardea"
          ]
        }
      }
    },
    {
      "Sid": "SoloS3DeJanoYSuEstado",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::jano-*",
        "arn:aws:s3:::jano-*/*",
        "arn:aws:s3:::fenora-terraform-state-966378755474",
        "arn:aws:s3:::fenora-terraform-state-966378755474/jano/*"
      ]
    },
    {
      "Sid": "ElBucketDeEstadoSoloSeLeeYSeEscribeEnJano",
      "Effect": "Deny",
      "NotAction": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::fenora-terraform-state-966378755474",
        "arn:aws:s3:::fenora-terraform-state-966378755474/*"
      ]
    },
    {
      "Sid": "SoloDynamoDBDeJanoYLocks",
      "Effect": "Deny",
      "Action": "dynamodb:*",
      "NotResource": [
        "arn:aws:dynamodb:*:966378755474:table/jano-*",
        "arn:aws:dynamodb:*:966378755474:table/jano-*/*",
        "arn:aws:dynamodb:eu-west-1:966378755474:table/fenora-terraform-locks"
      ]
    },
    {
      "Sid": "LaTablaDeLocksSoloBloquea",
      "Effect": "Deny",
      "NotAction": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:966378755474:table/fenora-terraform-locks"
    },
    {
      "Sid": "NoEngancharPoliticasDeAdministradorANadie",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:AttachUserPolicy",
        "iam:AttachGroupPolicy"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/AdministratorAccess",
            "arn:aws:iam::aws:policy/IAMFullAccess",
            "arn:aws:iam::aws:policy/PowerUserAccess"
          ]
        }
      }
    },
    {
      "Sid": "NoRepintarPoliticasNiUsuariosNiGrupos",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:PutUserPolicy",
        "iam:PutGroupPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoCrearCredencialesDeLargaVida",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateLoginProfile",
        "iam:UpdateLoginProfile",
        "iam:CreateServiceSpecificCredential",
        "iam:ResetServiceSpecificCredential",
        "iam:DeactivateMFADevice"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoOrganizacionesNiCambiosDeFacturacion",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:CloseAccount",
        "account:PutAlternateContact",
        "account:DeleteAlternateContact",
        "account:PutContactInformation",
        "payments:*",
        "purchase-orders:*",
        "billing:UpdateBillingPreferences",
        "billing:PutContractInformation",
        "billing:UpdateIAMAccessPreference",
        "aws-portal:ModifyBilling",
        "aws-portal:ModifyAccount",
        "aws-portal:ModifyPaymentMethods"
      ],
      "Resource": "*"
    }
  ]
