# Copia a terraform.tfvars (ignorado por git).
aws_profile        = "fintrack-dev"
parent_zone_name   = "tekhos.com"
landing_fqdn       = "jano.tekhos.com"
app_fqdn           = "jano-app.tekhos.com"
ses_from_address   = "jano@tekhos.com"
