{
  "name": "jano",
  "version": "0.1.0",
  "private": true,
  "description": "Jano — equipo comercial de IA para pymes B2B. Monorepo: landing, app, contratos e infraestructura.",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './frontend/*' --filter './packages/*' run build",
    "type-check": "pnpm -r run type-check",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:web": "pnpm --filter @jano/web dev",
    "dev:app": "pnpm --filter @jano/app dev"
  }
}
