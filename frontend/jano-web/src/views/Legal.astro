---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { pathFor, t, type Lang, type LegalKey } from "../i18n";
import { legalEn } from "../i18n/legal/en";
import { legalEs } from "../i18n/legal/es";
import type { LegalSet } from "../i18n/legal/types";
import { titular, type Titular } from "../i18n/titular";
import Base from "../layouts/Base.astro";

interface Props {
  lang: Lang;
  doc: LegalKey;
}

const { lang, doc: key } = Astro.props;
const d = t(lang);
const sets: Record<Lang, LegalSet> = { es: legalEs, en: legalEn };
const set = sets[lang];
const doc = set.docs[key];

// Solo se pintan los datos del titular que tienen valor.
const fields: (keyof Titular)[] = ["nombre", "razonSocial", "nif", "domicilio", "registro", "email", "web"];
const holder = fields
  .filter((f) => titular[f].trim() !== "")
  .map((f) => ({ key: f, label: set.holderLabels[f], value: titular[f] }));
---

<Base lang={lang} routeKey={key} title={`${doc.title} · Jano`} description={doc.description}>
  <Header lang={lang} routeKey={key} />
  <main id="contenido" class="mx-auto max-w-3xl px-4 pb-24 pt-14 sm:px-5 sm:pt-20">
    <a href={pathFor("home", lang)} class="inline-flex items-center gap-1.5 text-sm font-semibold text-jano-muted hover:text-jano-tinta">
      <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
        <path d="M12 4.5 6.5 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      {d.legal.backHome}
    </a>
    <h1 class="font-display mt-6 text-balance text-4xl font-bold leading-[1.05] sm:text-5xl">{doc.title}</h1>
    <p class="mt-3 text-sm text-jano-muted">{d.legal.updated}</p>

    <div class="prose-jano mt-8 max-w-[68ch]">
      {
        doc.sections.map((s) => (
          <section>
            <h2>{s.heading}</h2>
            {s.holder && holder.length > 0 && (
              <dl class="mt-4 grid gap-x-6 gap-y-2 rounded-2xl border border-jano-linea bg-jano-papel p-5 sm:grid-cols-[11rem_1fr]">
                {holder.map((h) => (
                  <>
                    <dt class="text-sm font-semibold text-jano-muted">{h.label}</dt>
                    <dd class="text-jano-tinta">
                      {h.key === "email" ? (
                        <a href={`mailto:${h.value}`}>{h.value}</a>
                      ) : h.key === "web" ? (
                        <a href={h.value}>{h.value.replace(/^https?:\/\//, "")}</a>
                      ) : (
                        h.value
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            )}
            {s.body.map((p) => (
              <p set:html={p} />
            ))}
          </section>
        ))
      }
    </div>
  </main>
  <Footer lang={lang} routeKey={key} />
</Base>
