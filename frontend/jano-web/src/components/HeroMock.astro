---
/**
 * Maqueta estática del centro de mando para el hero. Datos inventados y
 * etiquetados como tales. Mismo lenguaje visual que la app.
 */
const stages = [
  { label: "Encontradas", value: 312, w: 100, color: "bg-jano-tinta" },
  { label: "Fit alto", value: 148, w: 47, color: "bg-jano-tinta-2" },
  { label: "Contactadas", value: 96, w: 31, color: "bg-jano-cobalto" },
  { label: "Respondieron", value: 23, w: 8, color: "bg-jano-cobalto-claro" },
  { label: "Reuniones", value: 7, w: 3, color: "bg-jano-bronce" },
];
const agents = [
  { name: "Account Finder", text: "Leyendo 14 webs corporativas", dot: "bg-jano-verde" },
  { name: "Outreach", text: "Cambia Rumbo Norte a secuencia por señal de compra", dot: "bg-jano-cobalto-claro" },
  { name: "Response", text: "2 borradores esperan tu aprobación", dot: "bg-jano-bronce" },
];
---

<div class="relative rounded-3xl border border-jano-linea bg-jano-papel p-4 shadow-jano-elevado sm:p-5">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div>
      <div class="font-display text-lg font-bold">Centro de mando</div>
      <div class="text-xs text-jano-muted">Agencias de viajes · España · facturación superior a 1 M€</div>
    </div>
    <span class="shrink-0 whitespace-nowrap rounded-full bg-jano-bronce-tinte px-2.5 py-1 text-xs font-semibold text-jano-bronce-texto">Datos de ejemplo</span>
  </div>

  <div class="grid gap-3 sm:grid-cols-[1.4fr_1fr]">
    <div class="rounded-2xl border border-jano-linea bg-white p-4">
      <div class="mb-3 text-sm font-semibold">Embudo de la campaña</div>
      <ul class="space-y-2.5">
        {stages.map((s) => (
          <li>
            <div class="mb-1 flex items-center justify-between text-xs">
              <span class="font-semibold">{s.label}</span>
              <span class="font-mono tabular text-jano-muted">{s.value}</span>
            </div>
            <div class="h-2.5 rounded-full bg-jano-niebla">
              <div class={`h-2.5 rounded-full ${s.color}`} style={`width:${s.w}%`}></div>
            </div>
          </li>
        ))}
      </ul>
      <div class="ai-border mt-3 rounded-xl p-2.5 text-xs leading-relaxed">
        <b>Lectura de Jano:</b> las cuentas con vacante comercial responden tres veces más. Propongo priorizarlas.
      </div>
    </div>

    <div class="rounded-2xl border border-jano-linea bg-white p-4">
      <div class="mb-3 text-sm font-semibold">Agentes en vivo</div>
      <ul class="space-y-3">
        {agents.map((a) => (
          <li class="flex gap-2.5">
            <span class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${a.dot}`}></span>
            <div>
              <div class="text-xs font-semibold">{a.name}</div>
              <div class="text-xs text-jano-muted">{a.text}</div>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-4 rounded-xl bg-jano-bronce-tinte p-2.5 text-xs text-jano-bronce-texto">
        <b>Regla aplicada:</b> límite diario del buzón alcanzado. 12 envíos pasan a mañana.
      </div>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between rounded-2xl bg-jano-tinta p-3.5 text-white">
    <div>
      <div class="text-xs text-jano-sobre-tinta">Reuniones agendadas</div>
      <div class="font-display mt-1 text-3xl font-bold leading-none tabular">7<span class="text-base font-semibold text-jano-sobre-tinta"> de 12</span></div>
    </div>
    <span class="rounded-full bg-jano-tinta-2 px-3 py-1.5 text-xs font-semibold">
      <span class="mr-1.5 inline-block h-2 w-2 rounded-full bg-jano-bronce"></span>Tú apruebas
    </span>
  </div>
</div>
