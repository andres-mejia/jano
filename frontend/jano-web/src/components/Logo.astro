---
/**
 * Símbolo de Jano: puerta de dos hojas con un tirador en cada una.
 * Se lee también como dos perfiles mirando en sentidos opuestos.
 *
 * Con `animated`, al cargar las dos hojas parten cerradas, se abren desde
 * sus bisagras dejando ver luz y vuelven a la posición de reposo, que es el
 * logo de siempre. Con movimiento reducido se muestra quieto.
 */
interface Props {
  size?: number;
  left?: string;
  right?: string;
  dots?: string;
  dotsRight?: string;
  animated?: boolean;
  class?: string;
}

const {
  size = 32,
  left = "var(--color-jano-cobalto)",
  right = "var(--color-jano-bronce)",
  dots = "var(--color-jano-papel)",
  dotsRight = "var(--color-jano-tinta)",
  animated = false,
  class: className = "",
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  class:list={["jano-logo", { "jano-logo--animated": animated }, className]}
  style="flex-shrink: 0"
>
  {animated && <rect class="jano-logo__light" x="8" y="7" width="16" height="22" rx="2" fill="var(--color-jano-bronce-tinte)" />}
  <g class="jano-logo__leaf jano-logo__leaf--left">
    <path d="M4 29V15A11 11 0 0 1 15 4v25z" fill={left}></path>
    <circle cx="11.5" cy="18" r="1.6" fill={dots}></circle>
  </g>
  <g class="jano-logo__leaf jano-logo__leaf--right">
    <path d="M17 4a11 11 0 0 1 11 11v14H17z" fill={right}></path>
    <circle cx="20.5" cy="18" r="1.6" fill={dotsRight}></circle>
  </g>
</svg>

<style>
  .jano-logo--animated .jano-logo__leaf {
    transform-box: fill-box;
  }
  .jano-logo--animated .jano-logo__leaf--left {
    transform-origin: left center;
  }
  .jano-logo--animated .jano-logo__leaf--right {
    transform-origin: right center;
  }
  .jano-logo__light {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .jano-logo--animated .jano-logo__leaf--left {
      animation: jano-leaf-left 1.6s var(--ease-jano) 0.15s both;
    }
    .jano-logo--animated .jano-logo__leaf--right {
      animation: jano-leaf-right 1.6s var(--ease-jano) 0.15s both;
    }
    .jano-logo--animated .jano-logo__light {
      animation: jano-light 1.6s var(--ease-jano) 0.15s both;
    }
  }

  /* Cerrada (las hojas se tocan) → abierta de par en par → reposo. */
  @keyframes jano-leaf-left {
    0% {
      transform: translateX(1px) scaleX(1);
    }
    45% {
      transform: translateX(0) scaleX(0.42) skewY(-4deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes jano-leaf-right {
    0% {
      transform: translateX(-1px) scaleX(1);
    }
    45% {
      transform: translateX(0) scaleX(0.42) skewY(4deg);
    }
    100% {
      transform: none;
    }
  }
  @keyframes jano-light {
    0%,
    10% {
      opacity: 0;
    }
    45% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
