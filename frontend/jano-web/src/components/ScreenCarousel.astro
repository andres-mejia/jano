---
/**
 * Carrusel de pantallas reales de la app. Sin JS es una tira con scroll-snap
 * que se desplaza a mano. Con JS: botones, puntos, flechas del teclado y pase
 * automático que se pausa al pasar el ratón, al enfocar dentro, con el botón
 * de pausa, fuera de pantalla y siempre con movimiento reducido.
 */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).screens;
const total = s.items.length;
const label = (n: number) => s.slideLabel.replace("{n}", String(n)).replace("{total}", String(total));
---

<div
  class="carousel"
  role="region"
  aria-roledescription={s.roleCarousel}
  aria-label={s.regionLabel}
  data-carousel
  data-label-play={s.play}
  data-label-pause={s.pause}
>
  <div class="track relative -ml-4 mr-[calc(50%-50vw)] flex snap-x snap-mandatory scroll-px-4 sm:scroll-px-5 gap-4 overflow-x-auto px-4 pb-2 sm:-ml-5 sm:gap-6 sm:pl-5" data-track>
    {
      s.items.map((item, i) => (
        <figure
          class="slide w-[88%] shrink-0 snap-start sm:w-[80%] lg:w-[74%]"
          role="group"
          aria-roledescription={s.roleSlide}
          aria-label={`${label(i + 1)}: ${item.title}`}
          data-slide
        >
          <div class="overflow-hidden rounded-xl border border-jano-linea bg-jano-papel shadow-jano-elevado sm:rounded-2xl">
            <img
              src={`/media/pantallas/${item.file}.webp`}
              alt={item.alt}
              width="1920"
              height="1200"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
            />
          </div>
          <figcaption class="mt-4 max-w-2xl sm:mt-5">
            <span class="font-display text-lg font-bold sm:text-xl">{item.title}</span>
            <span class="mt-1 block text-pretty leading-relaxed text-jano-muted">{item.caption}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="mt-6 flex items-center gap-3 sm:mt-8">
    <div class="flex items-center gap-1.5" data-dots>
      {
        s.items.map((item, i) => (
          <button
            type="button"
            class="dot group flex h-8 items-center px-1"
            aria-label={`${s.goTo}: ${item.title}`}
            aria-current={i === 0 ? "true" : undefined}
            data-dot={i}
          >
            <span class="block h-1.5 w-1.5 rounded-full bg-jano-cobalto-linea transition-all duration-500 group-hover:bg-jano-cobalto-claro" />
          </button>
        ))
      }
    </div>
    <span class="ml-1 hidden whitespace-nowrap font-mono text-sm text-jano-muted tabular sm:inline" aria-hidden="true" data-counter>{label(1)}</span>
    <div class="ml-auto flex items-center gap-2">
      <button type="button" class="ctrl hidden" aria-label={s.pause} data-autoplay-toggle>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="icon-pause">
          <rect x="5" y="4" width="3.2" height="12" rx="1" fill="currentColor"></rect>
          <rect x="11.8" y="4" width="3.2" height="12" rx="1" fill="currentColor"></rect>
        </svg>
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" class="icon-play hidden">
          <path d="M6.5 4.2v11.6a.8.8 0 0 0 1.2.7l9-5.8a.8.8 0 0 0 0-1.4l-9-5.8a.8.8 0 0 0-1.2.7z" fill="currentColor"></path>
        </svg>
      </button>
      <button type="button" class="ctrl" aria-label={s.prev} data-prev>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M12 4.5 6.5 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="ctrl" aria-label={s.next} data-next>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M8 4.5 13.5 10 8 15.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .dot[aria-current="true"] span {
    width: 1.75rem;
    background: var(--color-jano-cobalto);
  }
  .ctrl {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid var(--color-jano-linea);
    background: var(--color-jano-papel);
    color: var(--color-jano-tinta);
    transition:
      border-color 0.2s,
      color 0.2s,
      transform 0.2s var(--ease-jano);
  }
  .ctrl:hover {
    border-color: var(--color-jano-cobalto);
    color: var(--color-jano-cobalto);
  }
  .ctrl:active {
    transform: scale(0.94);
  }
  .ctrl.hidden {
    display: none;
  }
  .slide img {
    transition: transform 1.2s var(--ease-jano);
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide:not(.is-current) img {
      transform: scale(0.97);
    }
  }
</style>

<script>
  const INTERVAL = 6500;

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const counter = root.querySelector<HTMLElement>("[data-counter]");
    const toggle = root.querySelector<HTMLButtonElement>("[data-autoplay-toggle]")!;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const total = slides.length;
    let current = 0;

    const setCurrent = (i: number) => {
      current = i;
      slides.forEach((s, j) => s.classList.toggle("is-current", j === i));
      dots.forEach((d, j) => (j === i ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
      if (counter) counter.textContent = counter.textContent!.replace(/^\d+/, String(i + 1));
    };

    const goTo = (i: number) => {
      const target = slides[(i + total) % total];
      if (!target) return;
      const left = target.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft);
      track.scrollTo({ left, behavior: reduce ? "auto" : "smooth" });
    };

    // La diapositiva actual es la que ocupa el centro de la tira.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setCurrent(slides.indexOf(e.target as HTMLElement));
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));
    setCurrent(0);

    root.querySelector("[data-prev]")?.addEventListener("click", () => goTo(current - 1));
    root.querySelector("[data-next]")?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
    root.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowRight") {
        ev.preventDefault();
        goTo(current + 1);
      } else if (ev.key === "ArrowLeft") {
        ev.preventDefault();
        goTo(current - 1);
      }
    });

    if (reduce) return;

    // Pase automático: solo con la tira en pantalla y sin interacción.
    let userPaused = false;
    let hovering = false;
    let focused = false;
    let visible = false;
    let timer: number | undefined;
    const running = () => !userPaused && !hovering && !focused && visible;
    const schedule = () => {
      window.clearInterval(timer);
      if (running()) timer = window.setInterval(() => goTo(current + 1), INTERVAL);
    };
    const renderToggle = () => {
      toggle.setAttribute("aria-label", (userPaused ? root.dataset.labelPlay : root.dataset.labelPause) ?? "");
      toggle.querySelector(".icon-pause")?.classList.toggle("hidden", userPaused);
      toggle.querySelector(".icon-play")?.classList.toggle("hidden", !userPaused);
    };
    toggle.classList.remove("hidden");
    toggle.addEventListener("click", () => {
      userPaused = !userPaused;
      renderToggle();
      schedule();
    });
    root.addEventListener("pointerenter", () => ((hovering = true), schedule()));
    root.addEventListener("pointerleave", () => ((hovering = false), schedule()));
    root.addEventListener("focusin", () => ((focused = true), schedule()));
    root.addEventListener("focusout", (ev) => {
      if (!root.contains(ev.relatedTarget as Node | null)) {
        focused = false;
        schedule();
      }
    });
    new IntersectionObserver(([e]) => {
      visible = Boolean(e?.isIntersecting);
      schedule();
    }, { threshold: 0.4 }).observe(root);
    renderToggle();
  });
</script>
