---
/**
 * Escenario del hero: el vídeo del producto flota en un marco de vidrio
 * sobre un campo animado que dibuja el flujo de trabajo (muchas cuentas que
 * se estrechan en el orquestador y se abren hacia las reuniones). El vidrio
 * tiene un efecto concreto: desenfoca las partículas que pasan por debajo
 * del marco y del botón de pausa.
 *
 * Si los ficheros de vídeo no existen todavía, el póster se queda fijo y el
 * botón de pausa se oculta. El aspect-ratio está reservado: no hay CLS.
 */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang).hero;

const W = 1200;
const MID = 380;
const lines = Array.from({ length: 11 }, (_, i) => {
  const y0 = 40 + i * 68;
  const pinch = MID + (y0 - MID) * 0.22;
  const y1 = MID + (y0 - MID) * 1.05 + (i % 2 === 0 ? 18 : -18);
  return {
    d: `M -40 ${y0} C 260 ${y0}, 420 ${pinch}, 600 ${pinch} S 940 ${y1}, ${W + 40} ${y1}`,
    warm: i === 3 || i === 8,
    dur: 9 + ((i * 7) % 5),
    delay: -((i * 1.7) % 9),
  };
});
const poster = `/media/jano-demo-${lang}.webp`;
---

<div class="stage relative isolate overflow-hidden rounded-[1.75rem] bg-jano-tinta px-2.5 pb-4 pt-2.5 sm:rounded-[2rem] sm:px-10 sm:pb-8 sm:pt-10 lg:px-16 lg:pb-10 lg:pt-14">
  <svg
    class="field pointer-events-none absolute inset-0 -z-10 h-full w-full"
    viewBox={`0 0 ${W} 760`}
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="stage-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--color-jano-tinta)" stop-opacity="0"></stop>
        <stop offset="1" stop-color="var(--color-jano-tinta-2)" stop-opacity="0.9"></stop>
      </linearGradient>
    </defs>
    <rect width={W} height="760" fill="url(#stage-fade)"></rect>
    {
      lines.map((l, i) => (
        <g>
          <path
            id={`stage-line-${i}`}
            class:list={["field__line", { "field__line--warm": l.warm }]}
            d={l.d}
            fill="none"
            pathLength="1"
            style={`--i:${i}`}
          />
          <circle class:list={["field__dot", { "field__dot--warm": l.warm }]} r={l.warm ? 3.5 : 2.5}>
            <animateMotion dur={`${l.dur}s`} begin={`${l.delay}s`} repeatCount="indefinite" rotate="auto">
              <mpath href={`#stage-line-${i}`} />
            </animateMotion>
          </circle>
        </g>
      ))
    }
  </svg>

  <figure class="frame relative">
    <div class="glass rounded-[1.25rem] p-1.5 shadow-jano-flotante sm:rounded-[1.4rem] sm:p-2.5">
      <div class="relative aspect-video overflow-hidden rounded-[0.9rem] bg-jano-tinta-2">
        <video
          class="absolute inset-0 h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster}
          width="1600"
          height="900"
          aria-label={h.videoLabel}
          data-hero-video
        >
          <source src={`/media/jano-demo-${lang}.webm`} type="video/webm" />
          <source src={`/media/jano-demo-${lang}.mp4`} type="video/mp4" data-last-source />
        </video>
        <button
          type="button"
          class="glass-chip absolute bottom-2.5 right-2.5 flex h-10 w-10 items-center justify-center rounded-full text-jano-papel sm:bottom-4 sm:right-4"
          aria-label={h.pause}
          data-label-play={h.play}
          data-label-pause={h.pause}
          data-video-toggle
        >
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class="icon-pause">
            <rect x="5" y="4" width="3.2" height="12" rx="1" fill="currentColor"></rect>
            <rect x="11.8" y="4" width="3.2" height="12" rx="1" fill="currentColor"></rect>
          </svg>
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" class="icon-play hidden">
            <path d="M6.5 4.2v11.6a.8.8 0 0 0 1.2.7l9-5.8a.8.8 0 0 0 0-1.4l-9-5.8a.8.8 0 0 0-1.2.7z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
    <figcaption class="mt-3 flex items-center gap-2 px-1 text-sm text-jano-sobre-tinta sm:mt-4 lg:justify-end">
      <span class="h-1.5 w-1.5 rounded-full bg-jano-bronce" aria-hidden="true"></span>
      {h.videoNote}
    </figcaption>

    <div class="ai-chip ai-border absolute -bottom-3 -left-6 hidden max-w-[16.5rem] rounded-2xl p-3.5 shadow-jano-elevado lg:block xl:-left-10">
      <p class="flex items-center gap-1.5 text-xs font-semibold text-jano-cobalto">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path
            d="M8 1.5 9.3 6.2 14 7.5 9.3 8.8 8 13.5 6.7 8.8 2 7.5 6.7 6.2z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linejoin="round"></path>
        </svg>
        {h.aiLabel}
      </p>
      <p class="mt-1 text-pretty text-sm leading-snug text-jano-tinta">{h.aiText}</p>
    </div>
  </figure>
</div>

<style>
  .field__line {
    stroke: var(--color-jano-cobalto-claro);
    stroke-opacity: 0.4;
    stroke-width: 1.25;
  }
  .field__line--warm {
    stroke: var(--color-jano-bronce);
    stroke-opacity: 0.4;
  }
  .field__dot {
    fill: var(--color-jano-cobalto-claro);
  }
  .field__dot--warm {
    fill: var(--color-jano-bronce);
  }

  /* Vidrio: deja ver, desenfocadas, las líneas y partículas que pasan por debajo. */
  .glass {
    background: color-mix(in srgb, var(--color-jano-papel) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-jano-papel) 22%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(150%);
    backdrop-filter: blur(14px) saturate(150%);
  }
  .glass-chip {
    background: color-mix(in srgb, var(--color-jano-tinta) 45%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-jano-papel) 30%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: background-color 0.2s;
  }
  .glass-chip:hover {
    background: color-mix(in srgb, var(--color-jano-tinta) 70%, transparent);
  }
  .glass-chip:focus-visible {
    outline: 2px solid var(--color-jano-bronce);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  /*
   * El momento de la página: al cargar, el campo se dibuja de izquierda a
   * derecha y el marco de vidrio sube y se enfoca mientras se abre la puerta
   * del logo.
   */
  @media (prefers-reduced-motion: no-preference) {
    .field__line {
      stroke-dasharray: 1;
      animation: field-draw 2.2s var(--ease-jano) both;
      animation-delay: calc(0.2s + var(--i) * 60ms);
    }
    .field__dot {
      animation: dot-in 0.8s ease-out 1.6s both;
    }
    .frame {
      animation: frame-in 1.4s var(--ease-jano) 0.35s both;
    }
    .ai-chip {
      animation: chip-in 1s var(--ease-jano) 1.5s both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .field__dot {
      display: none;
    }
  }
  @keyframes field-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes dot-in {
    from {
      opacity: 0;
    }
  }
  @keyframes frame-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
      filter: blur(6px);
    }
  }
  @keyframes chip-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-video-toggle]");
  const lastSource = video?.querySelector<HTMLSourceElement>("[data-last-source]");

  if (video && toggle) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const render = () => {
      const paused = video.paused;
      toggle.setAttribute("aria-label", (paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause) ?? "");
      toggle.querySelector(".icon-pause")?.classList.toggle("hidden", paused);
      toggle.querySelector(".icon-play")?.classList.toggle("hidden", !paused);
    };
    if (reduce.matches) {
      video.removeAttribute("autoplay");
      video.pause();
    }
    video.addEventListener("play", render);
    video.addEventListener("pause", render);
    toggle.addEventListener("click", () => {
      if (video.paused) void video.play().catch(() => undefined);
      else video.pause();
    });
    // Sin ficheros de vídeo, el póster queda como imagen fija y el botón sobra.
    const noVideo = () => toggle.classList.add("hidden");
    lastSource?.addEventListener("error", noVideo);
    if (video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) noVideo();
    render();
  }
</script>
