---
import { pathFor, t, type Lang, type RouteKey } from "../i18n";
import LangSwitch from "./LangSwitch.astro";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  routeKey: RouteKey;
}

const { lang, routeKey } = Astro.props;
const d = t(lang);
const home = pathFor("home", lang);
// En la home los anclajes son locales; desde otra página llevan a la home.
const base = routeKey === "home" ? "" : home;
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
---

<header class="sticky top-0 z-30 border-b border-jano-linea/70 bg-jano-niebla/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-6 sm:px-5">
    <a href={home} class="flex items-center gap-2.5 text-jano-tinta" aria-label={d.brand.homeLabel}>
      <Logo size={28} animated />
      <span class="font-display text-2xl font-bold">Jano</span>
    </a>
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label={d.nav.label}>
      {
        d.nav.items.map((l) => (
          <a
            href={`${base}#${l.id}`}
            class="rounded-lg px-3 py-2 text-[15px] font-semibold text-jano-muted transition-colors hover:bg-jano-papel hover:text-jano-tinta"
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-2 lg:ml-2">
      <LangSwitch lang={lang} routeKey={routeKey} />
      <a
        href={`${appUrl}/login`}
        class="hidden rounded-lg px-3 py-2 text-[15px] font-semibold text-jano-tinta transition-colors hover:bg-jano-papel sm:inline-flex"
        >{d.nav.login}</a
      >
      <a
        href={`${base}#${d.cta.id}`}
        class="whitespace-nowrap rounded-lg bg-jano-cobalto px-3.5 py-2 text-[15px] font-semibold text-jano-papel transition-colors hover:bg-jano-cobalto-oscuro sm:px-4"
      >
        {d.nav.cta}
      </a>
    </div>
  </div>
</header>
