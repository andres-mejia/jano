---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Jano es un equipo comercial de IA para pymes B2B españolas: encuentra cuentas, localiza al contacto, escribe en el momento oportuno y agenda la reunión. Tú apruebas lo que sale con tu nombre.",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://jano.example");
const canonical = new URL(Astro.url.pathname, site).toString();
const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://localhost:3000";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#14162b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ appUrl }}>
      window.__JANO_APP_URL__ = appUrl;
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <slot />
  </body>
</html>
