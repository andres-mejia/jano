---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
---

<Base title="No encontrado · Jano" noindex>
  <Header />
  <main class="mx-auto max-w-3xl px-5 py-24 text-center">
    <h1 class="font-display text-4xl font-bold">Esta puerta no existe</h1>
    <p class="mt-3 text-jano-muted">La página que buscas no está aquí.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-jano-cobalto px-5 py-2.5 font-semibold text-white">Volver al inicio</a>
  </main>
</Base>
